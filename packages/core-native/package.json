{
  "name": "@zenzip/core-native",
  "version": "0.1.0",
  "description": "Rust engine (napi-rs) for ZenZip — not used directly; install `zenzip`.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ravikisha/ZenZip.git",
    "directory": "packages/core-native"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "index.js",
    "index.d.ts"
  ],
  "napi": {
    "binaryName": "zenzip-core",
    "targets": [
      "x86_64-pc-windows-msvc",
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl",
      "aarch64-unknown-linux-musl"
    ]
  },
  "scripts": {
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.0.0"
  },
  "engines": {
    "node": ">= 18"
  }
}
