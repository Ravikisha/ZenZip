{
  "name": "zenzip",
  "version": "0.1.2",
  "description": "Agent-native backend framework for Node.js: durable workflows, queues, schedules, events, and AI agents on a Rust-powered runtime with zero infrastructure.",
  "keywords": [
    "durable-workflows",
    "queue",
    "job-queue",
    "task-queue",
    "background-jobs",
    "scheduler",
    "cron",
    "workflow-engine",
    "durable-execution",
    "ai-agents",
    "rust",
    "sqlite",
    "postgres",
    "inngest-alternative",
    "temporal-alternative",
    "bullmq-alternative"
  ],
  "license": "MIT",
  "author": "ZenZip",
  "homepage": "https://github.com/Ravikisha/ZenZip#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ravikisha/ZenZip.git",
    "directory": "packages/zenzip"
  },
  "bugs": {
    "url": "https://github.com/Ravikisha/ZenZip/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "require": "./dist/testing.cjs"
    }
  },
  "bin": {
    "zenzip": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/testing.ts --format esm,cjs --dts --clean && tsup src/cli.ts --format esm",
    "docs:api": "typedoc",
    "test": "vitest run"
  },
  "dependencies": {
    "@zenzip/core-native": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "tsup": "^8.0.0",
    "typedoc": "^0.28.19",
    "typescript": "^5.5.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">= 18"
  }
}
